        st.session_state.mode = "Break"
        st.session_state.time_left = break_minutes * 60
    else:
        play_sound("complete")
        st.info("🔔 [규칙 2 종료] 휴식 시간이 끝났습니다! 다시 작업에 집중하세요.")
        st.session_state.mode = "Work"
        st.session_state.time_left = work_minutes * 60

    st.rerun()

